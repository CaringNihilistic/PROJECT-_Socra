# Copy to .env and fill in what you have. Only one LLM key is needed; everything else is optional.
# docker compose reads this file; the backend alone (uvicorn) reads backend/.env.

# --- LLM providers (routing: Anthropic -> Google -> Groq, falling through on any failure) -------
ANTHROPIC_API_KEY=            # Claude Haiku 4.5, the primary model
GOOGLE_API_KEY=               # Gemini fallback (optional; its free tier is slow under load)
GROQ_API_KEY=                 # free fallback; alone it runs the whole app at no cost
TAVILY_API_KEY=               # live web research for the council (optional)

# true = canned demo answers, only for the 3 example ideas on the landing page. Also on when no key is set.
STUB_MODE=false

# --- Backend -----------------------------------------------------------------------------------
SECRET_KEY=dev_secret_key_change_in_prod
DATABASE_URL=postgresql://socra:socra_dev@postgres:5432/socra_db   # Neon/Render URLs work as-is
FRONTEND_ORIGIN=http://localhost:3000     # CORS + payment callback allowlist; exact URL, no trailing slash
ADMIN_EMAILS=                             # comma-separated Clerk emails that get admin shortcuts
LANGGRAPH_ENABLED=false                   # true = LangGraph council pipeline + Postgres checkpoints

# --- Auth (optional: without Clerk the app runs signed-out, and every request counts as admin) ---
CLERK_SECRET_KEY=
CLERK_FRONTEND_API_URL=                   # e.g. https://your-app.clerk.accounts.dev
VITE_CLERK_PUBLISHABLE_KEY=               # frontend, baked in at build time

# --- Donations and follow-up email (optional) ----------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=                     # when unset the UI shows [DEV] shortcuts instead of donations
RESEND_API_KEY=

# --- Observability (optional): traces every LLM call with latency, tokens and cost -------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
