# Add your Anthropic API key and set STUB_MODE=false for real responses.
# Leave ANTHROPIC_API_KEY empty and STUB_MODE=true only for offline demo
# (works only with the 3 example ideas on the landing page).

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=

# Set to true only for CI / offline demo with the landing page examples
STUB_MODE=false

SECRET_KEY=dev_secret_key_change_in_prod
DATABASE_URL=postgresql://socra:socra_dev@postgres:5432/socra_db
REDIS_URL=redis://redis:6379

# Langfuse LLM observability (optional — traces every LLM call with latency, tokens, cost)
# Sign up free at cloud.langfuse.com → create a project → copy keys from Settings → API Keys
# Free tier: 50k observations/month. Leave blank to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
